[FORMAT]
2.0

[DATA FILE]
data/acousticsGaussian3D.h

[MESH FILE]
BOX

[MESH DIMENSION]
3

[ELEMENT TYPE] # number of edges
12

[BOX NX]
5

[BOX NY]
5

[BOX NZ]
5

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TIME INTEGRATOR]
DOPRI5

[START TIME]
0

[FINAL TIME]
10

[OUTPUT INTERVAL]
1

# VTU visualization output (common to all solvers). HDF5/XDMF wave-field output
# (OUTPUT FORMAT) is a data-generation feature and lives in the data config; a
# standalone run like this one writes only VTU.
[OUTPUT TO FILE]
TRUE

[OUTPUT FILE NAME]
acoustics

[OUTPUT DIRECTORY]
out/

[SIMULATION ID]
acoustics_hex
