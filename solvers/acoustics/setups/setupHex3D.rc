[FORMAT]
2.0

[DATA FILE]
data/acousticsGaussian3D.h

[MESH FILE]
BOX

[MESH DIMENSION]
3

[ELEMENT TYPE] # number of edges
12

[BOX NX]
5

[BOX NY]
5

[BOX NZ]
5

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TIME INTEGRATOR]
DOPRI5

[START TIME]
0

[FINAL TIME]
10

[OUTPUT INTERVAL]
1

[OUTPUT TO FILE]
TRUE

[OUTPUT FILE NAME]
acoustics

# Write wave-field snapshots as HDF5 + XDMF for ParaView (open the .xdmf with
# the "XDMF Reader" or "Xdmf3 Reader T" — the temporal reader). Output files
# (<SIMULATION ID>.h5/.xdmf, and *_receivers.h5 if receivers configured) are
# written under OUTPUT DIRECTORY, which must exist before running.
[OUTPUT FORMAT]
XDMF

[OUTPUT DIRECTORY]
out/

[SIMULATION ID]
acoustics_hex
