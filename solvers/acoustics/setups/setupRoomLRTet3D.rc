[FORMAT]
2.0

[DATA FILE]
data/acousticsRoom3D.h

[MESH FILE]
BOX

[MESH DIMENSION]
3

[ELEMENT TYPE] # number of edges
6

[BOX NX]
8

[BOX NY]
8

[BOX NZ]
8

[BOX BOUNDARY FLAG]
3

[POLYNOMIAL DEGREE]
4

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

# EIRK4 treats the vectorfit pole accumulators implicitly, so the step size
# follows the mesh CFL alone. Under LSERK4 they are advanced explicitly and the
# fastest pole of the fit also has to satisfy |pole|*dt <= 2.78, which a stiffer
# material can push well below the CFL bound. Both give the same answer.
[TIME INTEGRATOR]
EIRK4

[START TIME]
0

[FINAL TIME]
0.05

[CFL NUMBER]
1.0

[DENSITY]
1.2

[SPEED OF SOUND]
343.0

[LR VECTORFIT FILE]
data/LRDATA14.dat

[OUTPUT INTERVAL]
0.01

[OUTPUT TO FILE]
FALSE

[OUTPUT FILE NAME]
acousticsRoomLR
