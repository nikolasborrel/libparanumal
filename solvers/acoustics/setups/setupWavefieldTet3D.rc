[FORMAT]
2.0

# Wave-field snapshot output on the built-in BOX mesh.
# Needs a build with HDF5 support:  make HDF5=1
# Produces out/wavefield.h5 + out/wavefield.xdmf — open the .xdmf in ParaView.

[DATA FILE]
data/acousticsGaussianFmax3D.h

# Source width follows from FMAX as sigma = 2c/(pi*FMAX); set SXYZ to give it
# explicitly instead.
[FMAX]
1.0

[SOURCE X]
0.5

[SOURCE Y]
0.0

[SOURCE Z]
-0.5

[MESH FILE]
BOX

[MESH DIMENSION]
3

[ELEMENT TYPE] # number of edges
6

[BOX NX]
4

[BOX NY]
4

[BOX NZ]
4

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
3

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TIME INTEGRATOR]
DOPRI5

[START TIME]
0

[FINAL TIME]
5

[OUTPUT INTERVAL]
0.25

# XDMF writes one dataset per snapshot plus a ParaView sidecar.
# H5COMPACT instead writes a single /pressures [nFrames x N] dataset.
[OUTPUT FORMAT]
XDMF

# Independent of OUTPUT FORMAT; both may be enabled at once.
[OUTPUT TO FILE]
FALSE

[OUTPUT DIRECTORY]
out/

[SIMULATION ID]
wavefield
