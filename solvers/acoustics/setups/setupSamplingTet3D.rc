[FORMAT]
2.0

# Field sampling on the built-in BOX mesh: records the pressure on the grids
# declared in SAMPLE SETS FILE, into out/sampling_samples.h5.
# Needs a build with HDF5 support:  make HDF5=1
# A step cadence requires TIME INTEGRATOR LSERK4.

[DATA FILE]
data/acousticsGaussianFmax3D.h

[MESH FILE]
BOX

[MESH DIMENSION]
3

[ELEMENT TYPE] # number of edges
6

[BOX NX]
4

[BOX NY]
4

[BOX NZ]
4

[BOX BOUNDARY FLAG]
1

[POLYNOMIAL DEGREE]
3

[THREAD MODEL]
CUDA

[PLATFORM NUMBER]
0

[DEVICE NUMBER]
0

[TIME INTEGRATOR]
LSERK4

[START TIME]
0

[FINAL TIME]
5

[OUTPUT INTERVAL]
1

# Sets the sample grid spacing (dx = c/(FMAX*ppw)) and the ppp cadence.
[FMAX]
1.0

[SOURCE X]
0.5

[SOURCE Y]
0.0

[SOURCE Z]
-0.5

[SAMPLE SETS FILE]
setups/sampleSets.txt

[OUTPUT TO FILE]
FALSE

[OUTPUT DIRECTORY]
out/

[SIMULATION ID]
sampling
